# SHA-256 of every upstream manifest the scripts apply, one "<sha256>  <url>" per line.
# The scripts refuse a download that doesn't match, so the cluster always gets exactly
# the files reviewed here. After changing a version in a script, update its lines with:
#   curl -fsSL <url> | sha256sum
# ci/validate.sh checks that every version in the scripts is pinned here and, online,
# that each hash still matches upstream.
