# Production values, read by deploy-ords.sh and, through the ords-db ConfigMap, by the pods.
# One KEY=value per line, no quotes.

# The existing Oracle database (from the old server's pool.xml). DB_IP is its IPv4 address:
# the pods reach the database only at that address, and map DB_HOST to it themselves.
# deploy-ords.sh stops while it's empty, and shows what DB_HOST resolves to.
DB_HOST=node.1apx.com
DB_IP=192.168.1.110
DB_PORT=1521
DB_SERVICE=pdb1

# APEX version for the /i/ static images, as major.minor (24.2, 26.1, ...). Leave empty to
# use the version installed in the database (the usual choice; it has APEX 26.1).
APEX_VERSION=

# Public host name (Cloudflare proxies it to the router, which forwards port 443 to LB_IP),
# and the Service's address in the MetalLB pool (k8s/manifests/addons/metallb-pool.yaml)
ORDS_HOSTNAME=www.1apx.com
LB_IP=192.168.1.180
